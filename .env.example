# ==========================================================================
# Variables SOLO para el script de migración (supabase/migrate.mjs).
# Copia este archivo a ".env" y rellena los valores. NUNCA subas ".env" a git.
# (Ya está en .gitignore.)
# ==========================================================================

# URL de tu proyecto (Supabase → Project Settings → API → Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# ⚠️ CLAVE SECRETA — service_role (Supabase → Project Settings → API).
# Da acceso total. No la pongas en el código ni la compartas.
SUPABASE_SERVICE_KEY=tu-clave-service_role-secreta
